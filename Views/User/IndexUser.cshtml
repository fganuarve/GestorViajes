@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Archivos CSS -->
    <link href="~/css/style.css" rel="stylesheet">
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>

<body>
    <div class="wrapper">
        <!-- Sidebar y contenido principal (lo que has proporcionado) -->
        <div class="main">
            <nav class="navbar navbar-expand px-4 py-3">
                <div class="navbar-collapse collapse">
                    <a href="#" class="text-body-secondary d-flex align-items-center text-tagline">
                        <em>“Encuentra lo extraordinario”</em>
                    </a>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a href="#" data-bs-toggle="dropdown" class="nav-icon pe-md-0">
                                <img src="~/img/logo3.png" class="avatar img-fluid" alt="Usuario">
                            </a>
                            <div class="dropdown-menu dropdown-menu-end rounded-0 border-0 shadow mt-3">
                                <a href="#" class="dropdown-item"><i class='bx bx-data'></i> <span>Perfil</span></a>
                                <a href="#" class="dropdown-item"><i class='bx bx-cog'></i><span>Configuración</span></a>
                                <div class="dropdown-divider"></div>
                                <a href="#" class="dropdown-item"><i class='bx bx-help-circle'></i><span>Ayuda</span></a>
                            </div>
                        </li>
                    </ul>
                </div>
            </nav>
            <main class="content px-3 py-4">
                <div class="container-fluid">
                    <!-- Carrusel de imágenes y demás contenido -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div id="carouselExampleIndicators" class="carousel slide shadow" data-bs-ride="carousel">
                                <div class="carousel-indicators">
                                    <button type="button" data-bs-target="#carouselExampleIndicators"
                                            data-bs-slide-to="0" class="active" aria-current="true"
                                            aria-label="Slide 1"></button>
                                    <button type="button" data-bs-target="#carouselExampleIndicators"
                                            data-bs-slide-to="1" aria-label="Slide 2"></button>
                                    <button type="button" data-bs-target="#carouselExampleIndicators"
                                            data-bs-slide-to="2" aria-label="Slide 3"></button>
                                </div>
                                <div class="carousel-inner rounded">
                                    <div class="carousel-item active">
                                        <img src="~/img/urbex1.jpg" class="d-block w-100" alt="Primera imagen">
                                    </div>
                                    <div class="carousel-item">
                                        <img src="~/img/urbex2.jpg" class="d-block w-100" alt="Segunda imagen">
                                    </div>
                                    <div class="carousel-item">
                                        <img src="~/img/urbex3.jpg" class="d-block w-100" alt="Tercera imagen">
                                    </div>
                                </div>
                                <button class="carousel-control-prev" type="button"
                                        data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Anterior</span>
                                </button>
                                <button class="carousel-control-next" type="button"
                                        data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Siguiente</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Contenido principal (tarjetas y tabla) -->
                    <div class="row g-4 mb-4">
                        <!-- Aquí van las tarjetas (Publicar viaje, Comunidad, Mis publicaciones) -->
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <h3 class="fw-bold fs-4 mb-3">Mis Viajes</h3>
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Destino</th>
                                        <th>Fecha</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th>1</th>
                                        <td>París</td>
                                        <td>12/06/2025</td>
                                        <td><span class="badge bg-success">Publicado</span></td>
                                    </tr>
                                    <tr>
                                        <th>2</th>
                                        <td>Tokyo</td>
                                        <td>22/08/2025</td>
                                        <td><span class="badge bg-warning text-dark">En revisión</span></td>
                                    </tr>
                                    <tr>
                                        <th>3</th>
                                        <td>Roma</td>
                                        <td>15/09/2025</td>
                                        <td><span class="badge bg-success">Publicado</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Archivos JS -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    <script src="~/js/script.js"></script>
</body>

