@model GestorViajes.Models.ViewModels.Vehicle.VehicleViewModel

@{
    ViewData["Title"] = "Editar Vehículo";
}

<!-- Mostrar mensajes -->
@if (TempData["message"] != null)
{
    <div class="alert alert-@(TempData["status"])">
        @TempData["message"]
    </div>
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Editar Vehículo</h2>
    <a href="@Url.Action("Index", "Vehicle")" class="btn btn-secondary">
        <i class='bx bx-arrow-back'></i> Volver a la lista
    </a>
</div>

<!-- Formulario de Edición -->
<form asp-action="EditSubmit" method="post">
    <input type="hidden" asp-for="Id" />

    <!-- Modelo -->
    <div class="mb-3">
        <label class="form-label fw-bold">Modelo</label>
        <input type="text" class="form-control" asp-for="Model" required />
    </div>

    <!-- Número de Plazas -->
    <div class="mb-3">
        <label class="form-label fw-bold">Número de Plazas</label>
        <input type="number" class="form-control" asp-for="MaxSeats" min="1" max="3" required />
    </div>

    <!-- Botón Guardar Cambios -->
    <button type="submit" class="btn btn-primary">
        Guardar Cambios
    </button>
</form>
