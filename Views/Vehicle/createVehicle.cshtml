@model GestorViajes.Models.ViewModels.Vehicle.VehicleViewModel

@{
    ViewData["Title"] = "Crear Vehículo";
}

<h2 class="mb-4">Crear Vehículo</h2>

@if (TempData["message"] != null)
{
<div class="alert alert-@(TempData[" status"])">
    @TempData["message"]
</div>
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="CreateVehicleSubmit" asp-controller="Vehicle" method="post">
    @Html.AntiForgeryToken()

    <!-- Matrícula -->
    <div class="mb-3">
        <label class="form-label fw-bold">Matrícula</label>
        <input type="text" class="form-control" asp-for="Plate" placeholder="Ej: 1234-ABC" required />
        <span asp-validation-for="Plate" class="text-danger"></span>
    </div>

    <!-- Modelo -->
    <div class="mb-3">
        <label class="form-label fw-bold">Modelo</label>
        <input type="text" class="form-control" asp-for="Model" placeholder="Ej: Toyota Corolla" required />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <!-- Color -->
    <div class="mb-3">
        <label class="form-label fw-bold">Color</label>
        <input type="text" class="form-control" asp-for="Color" placeholder="Ej: Rojo, Azul, Negro..." required />
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>

    <!-- Número de Plazas -->
    <div class="mb-3">
        <label class="form-label fw-bold">Número de Plazas</label>
        <div class="input-group" style="max-width: 200px;">
            <button type="button" class="btn btn-outline-secondary" onclick="cambiarPlazas(-1)">-</button>
            <input type="text" id="plazas" asp-for="MaxSeats" name="MaxSeats" class="form-control text-center" readonly />
            <button type="button" class="btn btn-outline-secondary" onclick="cambiarPlazas(1)">+</button>
        </div>
        <span asp-validation-for="MaxSeats" class="text-danger"></span>
        <small class="form-text text-muted">Máximo 3 plazas.</small>
    </div>

    <!-- Botón -->
    <button type="submit" class="btn btn-success">Crear Vehículo</button>
</form>

<!-- Script de control de plazas -->
<script>
    function cambiarPlazas(valor) {
        let plazasInput = document.getElementById('plazas');
        let plazas = parseInt(plazasInput.value) || 1;

        plazas += valor;
        if (plazas < 1) plazas = 1;
        if (plazas > 3) plazas = 3;

        plazasInput.value = plazas;
    }
</script>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
