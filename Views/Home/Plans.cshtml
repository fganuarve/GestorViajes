@inject GestorViajes.Services.Users.IUserService _userService;
@{ var current = await _userService.CurrentUser();}
@{
    ViewData["Title"] = "Planes de Suscripción";
}

<main id="main" role="main">
    <div class="pricing-header px-3 py-3 pt-md-5 pb-md-4 mx-auto text-center">
        <h1 class="display-4">Planes de Suscripción</h1>
        <p class="lead">
            Elige el plan que mejor se adapte a tus necesidades. ¡ En <strong>Rove</strong>, ofrecemos opciones accesibles para adaptarnos a ti!
        </p>
    </div>

    <div class="container">
        <div class="card-deck mb-3 text-center">
            <div class="card mb-4 box-shadow">
                <div class="card-header">
                    <h4 class="my-0 font-weight-normal">Básico</h4>
                </div>
                <div class="card-body">
                    <h1 class="card-title pricing-card-title">€25 <small class="text-muted">/ mes</small></h1>
                    <ul class="list-unstyled mt-3 mb-4">
                        <li>Acceso limitado a viajes</li>
                        <li>Soporte por correo y vía telefónica</li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4 box-shadow">
                <div class="card-header">
                    <h4 class="my-0 font-weight-normal">Premium</h4>
                </div>
                <div class="card-body">
                    <h1 class="card-title pricing-card-title">€45 <small class="text-muted">/ mes</small></h1>
                    <ul class="list-unstyled mt-3 mb-4">
                        <li>Viajes ilimitados</li>
                        <li>Soporte prioritario</li>
                        <li>Destacado en búsquedas</li>
                        <li>Sin publicidad</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a asp-controller="User" asp-action="Details" asp-route-id="@current.Id" class="btn btn-primary btn-lg mb-2">
                <i class="fa fa-cog"></i> Gestionar mi suscripción
            </a>
            <br />
            <a asp-controller="User" asp-action="Index" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Volver al inicio
            </a>
        </div>
    </div>
</main>
