@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="mb-3">
        <!-- Carousel de fotos-->
        <div class="row mb-4">
            <div class="col-12">
                <div id="carouselExampleIndicators" class="carousel slide shadow" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
                    </div>
                    <div class="carousel-inner rounded">
                        <div class="carousel-item active">
                            <img src="img/urbex1.jpg" class="d-block w-100" alt="Primera imagen">
                        </div>
                        <div class="carousel-item">
                            <img src="img/urbex2.jpg" class="d-block w-100" alt="Segunda imagen">
                        </div>
                        <div class="carousel-item">
                            <img src="img/urbex3.jpg" class="d-block w-100" alt="Tercera imagen">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Siguiente</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Publicar viaje -->
        <div class="col-12 col-md-4">
            <div class="card shadow">
                <div class="card-body py-4">
                    <h6 class="mb-2 fw-bold">Publicar viaje</h6>
                    <p>
                        Organiza y publica tu próximo destino. Comparte los detalles con otros viajeros.
                    </p>
                    <a href="#" class="btn btn-success btn-sm mt-2">Publicar</a>
                </div>
            </div>
        </div>

        <!-- Comunidad -->
        <div class="col-12 col-md-4">
            <div class="card shadow" style="background-color: #1b4724; color: #FFF;">
                <div class="card-body py-4">
                    <h6 class="mb-2 fw-bold">Comunidad</h6>
                    <p>
                        Conecta con otros aventureros, comparte experiencias y forma parte de nuestra red.
                    </p>
                    <a href="#" class="btn btn-light btn-sm mt-2">Ver Comunidad</a>
                </div>
            </div>
        </div>

        <!-- Mis publicaciones -->
        <div class="col-12 col-md-4">
            <div class="card shadow">
                <div class="card-body py-4">
                    <h6 class="mb-2 fw-bold">Mis publicaciones</h6>
                    <p>
                        Revisa y gestiona todos los viajes y experiencias que has compartido hasta ahora.
                    </p>
                    <a href="#" class="btn btn-success btn-sm mt-2">Mis Viajes</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <h3 class="fw-bold fs-4 mb-3">Mis Viajes</h3>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Destino</th>
                        <th scope="col">Fecha</th>
                        <th scope="col">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row">1</th>
                        <td>París</td>
                        <td>12/06/2025</td>
                        <td>Publicado</td>
                    </tr>
                    <tr>
                        <th scope="row">2</th>
                        <td>Tokyo</td>
                        <td>22/08/2025</td>
                        <td>En revisión</td>
                    </tr>
                    <tr>
                        <th scope="row">3</th>
                        <td>Roma</td>
                        <td>15/09/2025</td>
                        <td>Publicado</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
