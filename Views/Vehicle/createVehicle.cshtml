@model GestorViajes.Models.ViewModels.Vehicle.VehicleViewModel

@{
    ViewData["Title"] = "Crear Vehículo";
}

<h2 class="mb-4">Crear Vehículo</h2>

<!-- Mostrar mensajes de error o exito -->
@if (TempData["message"] != null)
{
    <div class="alert alert-@(TempData["status"])">
        @TempData["message"]
    </div>
}

<!-- Mostrar errores de validación -->
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="CreateSubmit" asp-controller="Vehicle" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <!-- Modelo -->
    <div class="mb-3">
        <label class="form-label fw-bold">Modelo</label>
        <input type="text" class="form-control" asp-for="Model" placeholder="Modelo del vehículo" required>
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <!-- Número de Plazas -->
    <div class="mb-3">
        <label class="form-label fw-bold">Número de Plazas</label>
        <div class="input-group" style="max-width: 200px;">
            <button type="button" class="btn btn-outline-secondary" onclick="cambiarPlazas(-1)">-</button>
            <input type="text" id="plazas" name="Seats" asp-for="MaxSeats" class="form-control text-center" readonly>
            <button type="button" class="btn btn-outline-secondary" onclick="cambiarPlazas(1)">+</button>
        </div>
        <span asp-validation-for="MaxSeats" class="text-danger"></span>
        <small class="form-text text-muted">Máximo 3 plazas.</small>
    </div>

    <!-- Vehículo (selección de tipo o marca) -->
    <div class="mb-3">
        <label class="form-label fw-bold">Seleccionar Vehículo</label>
        <select class="form-select" asp-for="Id" required>
            <option selected disabled>Elige tu vehículo</option>
            <option value="1">Toyota Corolla</option>
            <option value="2">Seat León</option>
            <option value="3">Ford Fiesta</option>
        </select>
        <span asp-validation-for="Id" class="text-danger"></span>
    </div>

    <!-- Adjuntar Imagen (opcional) -->
    @* Descomenta si se usa en el modelo *@
    <!--
    <div class="mb-3">
        <label class="form-label fw-bold">Adjuntar Imagen</label>
        <input type="file" class="form-control" asp-for="Imagen" accept="image/*">
        <small class="form-text text-muted">Selecciona una imagen para asociar con el vehículo (opcional).</small>
        <span asp-validation-for="Imagen" class="text-danger"></span>
    </div>
    -->
    <!-- Botón Crear Vehículo -->
    <button type="submit" class="btn btn-success">Crear Vehículo</button>
</form>

<!-- Script para controlar las plazas -->
<script>
    function cambiarPlazas(valor) {
        let plazasInput = document.getElementById('plazas');
        let plazas = parseInt(plazasInput.value) || 1;

        plazas += valor;
        if (plazas < 1) plazas = 1;
        if (plazas > 3) plazas = 3;

        plazasInput.value = plazas;
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
