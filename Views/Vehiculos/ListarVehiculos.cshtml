@model List<YourApp.Models.ViewModels.VehiculoViewModel>
    @using YourApp.Translations

    @{
    ViewData["Title"] = VehiculoTranslations.TTL_ListVehiculos;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var status = TempData["status"] as string ?? "";
    var errorMsg = TempData["message"] as string ?? "";
    }

    @if (!string.IsNullOrWhiteSpace(status))
    {
    <div class="alert alert-@status">
        @errorMsg
    </div>
    }

    <div class="container-fluid mt-4">
        <!-- Barra de herramientas -->
        <div class="d-flex justify-content-between mb-3">
            <div class="d-flex">
                <input type="text" id="searchVehiculoId" class="form-control me-2 w-auto" placeholder="@VehiculoTranslations.PLH_SearchByVehiculoId" style="max-width: 250px;" />
                <button class="btn btn-outline-primary" id="searchButton">@Common.BTN_Search</button>
            </div>

            <a href="@Url.Action(" Create", "Vehiculo" )" class="btn btn-outline-primary">@VehiculoTranslations.BTN_AddVehiculo</a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-dark table-hover mt-3 w-100">
                <thead class="text-center">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.First().LicensePlate)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Brand)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Model)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Year)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Status)</th>
                        <th>@Html.DisplayNameFor(model => model.First().LastServiceDate)</th>
                        <th style="width: 150px;">@Common.LBL_Actions</th>
                    </tr>
                </thead>
                <tbody class="text-center align-middle">
                    @foreach (var vehiculo in Model)
                    {
                    <tr>
                        <td>@Html.DisplayFor(_ => vehiculo.LicensePlate)</td>
                        <td>@Html.DisplayFor(_ => vehiculo.Brand)</td>
                        <td>@Html.DisplayFor(_ => vehiculo.Model)</td>
                        <td>@Html.DisplayFor(_ => vehiculo.Year)</td>
                        <td>@Html.DisplayFor(_ => vehiculo.Status)</td>
                        <td>@(vehiculo.LastServiceDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Details" asp-controller="Vehiculo" asp-route-id="@vehiculo.Id" title="@Common.BTN_View">
                                    <i class="fa-solid fa-eye pe-2 icon-style"></i>
                                </a>
                                <a asp-action="Edit" asp-controller="Vehiculo" asp-route-id="@vehiculo.Id" title="@Common.BTN_Edit">
                                    <i class="fa-solid fa-pencil pe-2 icon-style"></i>
                                </a>
                                <a onclick="confirmDelete(@vehiculo.Id)" title="@Common.BTN_Delete">
                                    <i class="fa-solid fa-trash pe-2 icon-style"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
