@model IEnumerable<GestorViajes.Models.ViewModels.Vehicle.VehicleViewModel>

@{
    ViewData["Title"] = "Mis Vehículos";
}

<!-- Mostrar mensajes de estado -->
@if (TempData["message"] != null)
{
    <div class="alert alert-@(TempData["status"])">
        @TempData["message"]
    </div>
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Mis Vehículos</h2>
    <a href="@Url.Action("Create", "Vehicle")" class="btn btn-primary">
        <i class='bx bx-plus'></i> Crear nuevo vehículo
    </a>
</div>

<!-- Tabla de vehículos -->
@if (!Model.Any())
{
    <div class="alert alert-info">
        Aún no tienes vehículos registrados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Modelo</th>
                    <th>Plazas</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in Model)
                {
                    <tr>
                        <td>@vehicle.Model</td>
                        <td>@vehicle.MaxSeats</td>
                        <td>
                            <a href="@Url.Action("Edit", "Vehicle", new { id = vehicle.Id })" class="btn btn-sm btn-warning me-1">
                                <i class='bx bx-edit'></i> Editar
                            </a>
                            <a href="@Url.Action("Delete", "Vehicle", new { id = vehicle.Id })" class="btn btn-sm btn-danger">
                                <i class='bx bx-trash'></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
