@model GestorViajes.Models.ViewModels.User.UserViewModel

@{
    Layout = null;
}

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro - Rove</title>
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script src="https://kit.fontawesome.com/574cdde0a1.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="~/css/styleRegister.css">
</head>

<body>
    <section id="auth">
        <div class="login-row">
            <div class="login-main">
                <div class="auth-text">
                    <h1>Crear cuenta</h1>
                    ¿Ya tienes cuenta? <a href="/Account/Login">Inicia sesión</a>
                </div>

                <!-- Mostrar mensajes de éxito o error -->
                @if (TempData["message"] != null)
                {
                    <div class="alert alert-@TempData["status"]">
                        @TempData["message"]
                    </div>
                }

                <!-- Formulario de registro -->
            <form asp-action="AccountRegister" asp-controller="Account" method="post">
                @Html.ValidationSummary(true, "", new { @class = "error-message" })
                <!-- Tengo el rol como parametro oculto para que funcione el Add -->
                @Html.HiddenFor(m => m.SelectedRol)

                <div class="form-container">
                    <div class="form-element">
                        <input asp-for="FirstName" class="input-control" placeholder="Nombre" />
                        <span asp-validation-for="FirstName" class="error-message"></span>
                    </div>
                    <div class="form-element">
                        <input asp-for="LastName" class="input-control" placeholder="Primer apellido" />
                        <span asp-validation-for="LastName" class="error-message"></span>
                    </div>
                    <div class="form-element">
                        <input asp-for="LastName2" class="input-control" placeholder="Segundo apellido (opcional)" />
                        <span asp-validation-for="LastName2" class="error-message"></span>
                    </div>
                    <div class="form-element">
                        <input asp-for="NationalId" class="input-control" placeholder="DNI/NIF" />
                        <span asp-validation-for="NationalId" class="error-message"></span>
                    </div>
                    <div class="form-element">
                        <input asp-for="PhoneNumber" class="input-control" placeholder="Teléfono (opcional)" />
                        <span asp-validation-for="PhoneNumber" class="error-message"></span>
                    </div>
                    <div class="form-element">
                        <input asp-for="Email" class="input-control" placeholder="Correo electrónico" />
                        <span asp-validation-for="Email" class="error-message"></span>
                    </div>
                    <div class="form-element">
                        <input asp-for="Password" type="password" class="input-control password" placeholder="Contraseña" />
                        <span asp-validation-for="Password" class="error-message"></span>
                    </div>
                    <div class="form-element">
                        <button type="submit" class="btn-submit">Registrarme</button>
                    </div>
                </div>
            </form>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        var swiper = new Swiper(".swiper", {
            slidesPerView: 1,
            loop: true,
            pagination: {
                el: ".swiper-pagination",
                renderBullet: function (index, className) {
                    return '<li class="' + className + '"></li>';
                },
                clickable: true,
            },
            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
            },
        });
    </script>
</body>
