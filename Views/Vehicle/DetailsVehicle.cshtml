@model GestorViajes.Models.ViewModels.Vehicle.VehicleViewModel

@{
    ViewData["Title"] = "Detalles del Vehículo";
}

<!-- Mostrar mensajes si hay -->
@if (TempData["message"] != null)
{
    <div class="alert alert-@(TempData["status"])">
        @TempData["message"]
    </div>
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Detalles del Vehículo</h2>
    <a href="@Url.Action("Index", "Vehicle")" class="btn btn-secondary">
        <i class='bx bx-arrow-back'></i> Volver a la lista
    </a>
</div>

<!-- Detalles del vehículo -->
<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Modelo</dt>
            <dd class="col-sm-9">@Model.Model</dd>

            <dt class="col-sm-3">Número de Plazas</dt>
            <dd class="col-sm-9">@Model.MaxSeats</dd>

            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            @* Si tienes más propiedades como Imagen o Color, las puedes añadir aquí *@
        </dl>
    </div>
</div>
