@model IEnumerable<GestorViajes.Models.ViewModels.Trip.TripViewModel>

@{
    ViewData["Title"] = "Mis Viajes";
}

<!-- Mostrar mensajes de estado -->
@if (TempData["message"] != null)
{
    <div class="alert alert-@(TempData["status"])">
        @TempData["message"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Mis Viajes</h2>
    <a class="btn btn-primary" asp-controller="Trip" asp-action="CreateTrip">
        <i class='bx bx-plus'></i> Publicar Nuevo Viaje
    </a>
</div>

<!-- Tabla de viajes -->
@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Origen</th>
                    <th>Destino</th>
                    <th>Fecha</th>
                    <th>Precio</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var trip in Model)
                {
                    <tr>
                        <td>@trip.Origin</td>
                        <td>@trip.Destination</td>
                        @*<td>@trip.Date.ToString("dd/MM/yyyy")</td>
                        <td>@trip.Price.ToString("C")</td>*@
                        <td>
                            <a class="btn btn-sm btn-info" asp-action="DetailsTrip" asp-route-id="@trip.Id">
                                <i class='bx bx-show'></i> Detalles
                            </a>
                            <a class="btn btn-sm btn-warning" asp-action="EditTrip" asp-route-id="@trip.Id">
                                <i class='bx bx-edit'></i> Editar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        No se encontraron viajes publicados.
    </div>
}
