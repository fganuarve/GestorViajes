@model GestorViajes.ViewModels.FuelTicketViewModel

@{
    ViewData["Title"] = "Añadir Ticket de Combustible";
}

<h2 class="fw-bold mb-4">Añadir Ticket de Combustible</h2>

<div class="alert alert-secondary">
    <strong>Instrucciones:</strong><br />
    Adjunta el ticket de combustible que has gastado en tu viaje para que te abonemos la parte del importe correspondiente y ayudarte a costear los gastos.<br />
    Recuerda incluir la <strong>fecha</strong>, el <strong>origen</strong> y el <strong>destino</strong> de tu viaje en la <strong>descripción</strong> y adjunta una <strong>fotografía del ticket</strong>.
</div>

@if (TempData["message"] != null)
{
    <div class="alert alert-@TempData["status"]">
        @TempData["message"]
    </div>
}

<form asp-action="Create" asp-controller="FuelTicket" method="post" enctype="multipart/form-data">
	<div class="mb-3">
		<label asp-for="Notes" class="form-label"></label>
		<textarea asp-for="Notes" class="form-control" rows="3"></textarea>
		<span asp-validation-for="Notes" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="Amount" class="form-label"></label>
		<input asp-for="Amount" class="form-control" type="text" />
		<span asp-validation-for="Amount" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="ImageFile" class="form-label"></label>
		<input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png" onchange="previewImage(event)" />
		<span asp-validation-for="ImageFile" class="text-danger"></span>
	</div>

	<div class="row mb-3">
		<div class="col-md-6" id="preview-container" style="display: none;">
			<label class="form-label">Nueva imagen:</label><br />
			<img id="preview-image" class="img-fluid rounded border" style="max-height: 300px;" />
		</div>
	</div>

	<button type="submit" class="btn btn-primary">
		<i class='bx bx-save'></i> Guardar Ticket
	</button>
	<a asp-action="Index" class="btn btn-secondary ms-2">
		<i class='bx bx-arrow-back'></i> Cancelar
	</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<script>
	function previewImage(event) {
	const input = event.target;
	const previewContainer = document.getElementById('preview-container');
	const previewImage = document.getElementById('preview-image');

	if (input.files && input.files[0]) {
		const file = input.files[0];

		const allowedTypes = ['image/jpeg', 'image/png'];
		if (!allowedTypes.includes(file.type)) {
			alert('Solo se permiten archivos JPG o PNG.');
			input.value = '';
			previewContainer.style.display = 'none';
			return;
		}

		const reader = new FileReader();
		reader.onload = function (e) {
			previewImage.src = e.target.result;
			previewContainer.style.display = 'block';
		};
		reader.readAsDataURL(file);
	}
}
</script>