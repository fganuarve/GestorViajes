
    @{
        ViewData["Title"] = "ListUsers";
        Layout = "~/Views/Shared/_Layout.cshtml";

        var status = TempData["status"] as string ?? "";
        var errorMsg = TempData["message"] as string ?? "";
    }

    @if (!string.IsNullOrWhiteSpace(status))
    {
        <div class="alert alert-@status">
            @errorMsg
        </div>
    }

    <div class="container-fluid mt-4">
        <!-- Barra de herramientas -->
        <div class="d-flex justify-content-between mb-3">
            <div class="d-flex">
                <input type="text" id="searchUserId" class="form-control me-2 w-auto" placeholder="SearchByUserId" style="max-width: 250px;" />
                <button class="btn btn-outline-primary" id="searchButton">BTN_Search</button>
            </div>

            <a href="@Url.Action("Create", "User")" class="btn btn-outline-primary">"AddUser""</a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-dark table-hover mt-3 w-100">
                <thead class="text-center">
                    <tr>
                        
                        <th style="width: 150px;">"LBL_Actions</th>
                    </tr>
                </thead>
                <tbody class="text-center align-middle">
                    @foreach (var user in Model)
                    {
                        <tr>
                           
                            <td>@(user.LastLoginDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Details" asp-controller="User" asp-route-id="@user.Id" title="View">
                                        <i class="fa-solid fa-eye pe-2 icon-style"></i>
                                    </a>
                                    <a asp-action="Edit" asp-controller="User" asp-route-id="@user.Id" title="_Edit">
                                        <i class="fa-solid fa-pencil pe-2 icon-style"></i>
                                    </a>
                                    <a onclick="confirmDelete(@user.Id)" title="BTN_Delete">
                                        <i class="fa-solid fa-trash pe-2 icon-style"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
