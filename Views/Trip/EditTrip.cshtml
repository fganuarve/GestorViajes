@model GestorViajes.Models.ViewModels.Trip.TripViewModel

@{
    ViewData["Title"] = "Detalles del Viaje";
}

<h2 class="mb-4">Detalles del Viaje</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Origen</dt>
            <dd class="col-sm-9">@Model.Origin</dd>

            <dt class="col-sm-3">Destino</dt>
            <dd class="col-sm-9">@Model.Destination</dd>

            @*<dt class="col-sm-3">Fecha</dt>
            <dd class="col-sm-9">@Model.Date.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Precio</dt>
            <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

            <dt class="col-sm-3">Descripción</dt>
            <dd class="col-sm-9">@Model.Description</dd>*@
        </dl>

        <a asp-action="IndexTrip" class="btn btn-secondary mt-3">
            <i class='bx bx-arrow-back'></i> Volver a la lista
        </a>
    </div>
</div>
