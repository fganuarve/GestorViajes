@model IEnumerable<GestorViajes.Models.ViewModels.Vehicle.VehicleViewModel>

@{
    ViewData["Title"] = "Mis Vehículos";
}

@if (TempData["message"] != null)
{
    <div class="alert alert-@(TempData["status"])">
        @TempData["message"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Mis Vehículos</h2>
    <a href="@Url.Action("CreateVehicle", "Vehicle")" class="btn btn-primary">
        <i class='bx bx-plus'></i> Añadir vehículo
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Aún no tienes vehículos registrados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Matrícula</th>
                    <th>Modelo</th>
                    <th>Color</th>
                    <th>Plazas</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in Model)
                {
                    <tr>
                        <td>@vehicle.Plate</td>
                        <td>@vehicle.Model</td>
                        <td>@vehicle.Color</td>
                        <td>@vehicle.MaxSeats</td>
                        <td>
                            @if (vehicle.Active)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("EditVehicle", "Vehicle", new { id = vehicle.Id })" class="btn btn-sm btn-warning me-1">
                                <i class='bx bx-edit'></i> Editar
                            </a>

                            @if (vehicle.Active)
                            {
                                <button type="button" class="btn btn-sm btn-danger" onclick="confirmarDesactivacion(@vehicle.Id)">
                                    <i class='bx bx-trash'></i> Desactivar
                                </button>

                                <form id="form-desactivar-@vehicle.Id" method="post" asp-action="DeactivateVehicle" asp-controller="Vehicle" asp-route-id="@vehicle.Id" style="display: none;">
                                    @Html.AntiForgeryToken()
                                </form>
                            }
                            else
                            {
                                <form id="form-reactivar-@vehicle.Id" method="post" asp-action="ReactivateVehicle" asp-controller="Vehicle" asp-route-id="@vehicle.Id" style="display: none;">
                                    @Html.AntiForgeryToken()
                                </form>

                                <button type="button" class="btn btn-sm btn-success" onclick="confirmarReactivacion(@vehicle.Id)">
                                    <i class='bx bx-revision'></i> Reactivar
                                </button>

                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<!-- Estilo para SweetAlert2 para tener espaciado entre botones -->
<style>
    .swal2-actions button {
        margin: 0 5px;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function confirmarDesactivacion(id) {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: "btn btn-success me-2",
                    cancelButton: "btn btn-danger"
                },
                buttonsStyling: false
            });

            swalWithBootstrapButtons.fire({
                title: "¿Desactivar vehículo?",
                text: "Podrás reactivarlo más tarde si lo necesitas.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Sí, desactivar",
                cancelButtonText: "Cancelar",
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`form-desactivar-${id}`).submit();
                }
            });
        }

    </script>
    <script>
        function confirmarReactivacion(id) {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: "btn btn-success me-2",
                    cancelButton: "btn btn-secondary"
                },
                buttonsStyling: false
            });

            swalWithBootstrapButtons.fire({
                title: "¿Reactivar vehículo?",
                text: "El vehículo volverá a estar disponible para crear viajes.",
                icon: "question",
                showCancelButton: true,
                confirmButtonText: "Sí, reactivar",
                cancelButtonText: "Cancelar",
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`form-reactivar-${id}`).submit();
                }
            });
        }
    </script>

}
