@model List<YourApp.Models.ViewModels.ViajeViewModel>
@using YourApp.Translations

@{
    ViewData["Title"] = ViajeTranslations.TTL_ListViajes;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var status = TempData["status"] as string ?? "";
    var errorMsg = TempData["message"] as string ?? "";
}

@if (!string.IsNullOrWhiteSpace(status))
{
    <div class="alert alert-@status">
        @errorMsg
    </div>
}

<div class="container-fluid mt-4">
    <!-- Barra de herramientas -->
    <div class="d-flex justify-content-between mb-3">
        <div class="d-flex">
            <input type="text" id="searchViajeId" class="form-control me-2 w-auto" placeholder="@ViajeTranslations.PLH_SearchByViajeId" style="max-width: 250px;" />
            <button class="btn btn-outline-primary" id="searchButton">@Common.BTN_Search</button>
        </div>

        <a href="@Url.Action("Create", "Viaje")" class="btn btn-outline-primary">@ViajeTranslations.BTN_AddViaje</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-dark table-hover mt-3 w-100">
            <thead class="text-center">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.First().Destination)</th>
                    <th>@Html.DisplayNameFor(model => model.First().DepartureDate)</th>
                    <th>@Html.DisplayNameFor(model => model.First().ReturnDate)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Status)</th>
                    <th style="width: 150px;">@Common.LBL_Actions</th>
                </tr>
            </thead>
            <tbody class="text-center align-middle">
                @foreach (var viaje in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(_ => viaje.Destination)</td>
                        <td>@(viaje.DepartureDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@(viaje.ReturnDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@Html.DisplayFor(_ => viaje.Status)</td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Details" asp-controller="Viaje" asp-route-id="@viaje.Id" title="@Common.BTN_View">
                                    <i class="fa-solid fa-eye pe-2 icon-style"></i>
                                </a>
                                <a asp-action="Edit" asp-controller="Viaje" asp-route-id="@viaje.Id" title="@Common.BTN_Edit">
                                    <i class="fa-solid fa-pencil pe-2 icon-style"></i>
                                </a>
                                <a onclick="confirmDelete(@viaje.Id)" title="@Common.BTN_Delete">
                                    <i class="fa-solid fa-trash pe-2 icon-style"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
