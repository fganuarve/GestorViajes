@model GestorViajes.Models.ViewModels.User.UserViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

@if (TempData["message"] != null)
{
    <div class="alert alert-@TempData["status"]">
        @TempData["message"]
    </div>
}

<form asp-action="EditSubmit" method="post" class="card shadow p-4" enctype="multipart/form-data">
    @Html.HiddenFor(m => m.Id)

    <div class="mb-3">
        <label class="form-label fw-bold">Correo Electrónico</label>
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "required" })
        @Html.ValidationMessageFor(m => m.Email, null, new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Contraseña</label>
        @Html.PasswordFor(m => m.Password, new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(m => m.Password, null, new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Nombre</label>
        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", required = "required" })
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Apellido</label>
        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Segundo Apellido</label>
        @Html.TextBoxFor(m => m.LastName2, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">DNI</label>
        @Html.TextBoxFor(m => m.NationalId, new { @class = "form-control", required = "required" })
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Teléfono</label>
        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Rol</label>
        @Html.DropDownListFor(m => m.SelectedRol, Model.Roles, "Selecciona un rol", new { @class = "form-select", required = "required" })
    </div>

    <button type="submit" class="btn btn-success w-100">
        <i class='bx bx-save'></i> Guardar Cambios
    </button>
    <hr class="my-4" />
    <form asp-action="Delete" method="post" onsubmit="return confirm('¿Estás seguro de que deseas borrar tu cuenta? Esta acción no se puede deshacer.');">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger w-100">
            <i class='bx bx-trash'></i> Borrar mi cuenta
        </button>
    </form>

</form>
