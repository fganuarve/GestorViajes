<!-- Solo en _Layout tenemos este fragmento de código una vez en cada proyecto -->
<!-- Solo en _Layout tenemos la estructura que es común al resto de vistas -->
<!-- Las que no queremos que apliquen layout tenemos que especificarlo -->
<!-- Aqui estoy caputurando el id del user que esta logueado -->
@inject GestorViajes.Services.Users.IUserService _userService;
@{ var current = await _userService.CurrentUser();}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Rove</title>
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
</head>

<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <aside id="sidebar">
            <div class="d-flex justify-content-between p-4" style="border-bottom: 1px dashed #606164;">
                <div class="sidebar-logo">
                    <a href="#">Rove</a>
                </div>
                <button class="toggle-btn border-0" type="button">
                    <i id="icon" class='bx bxs-chevrons-right'></i>
                </button>
            </div>
            <ul class="sidebar-nav">
                <li class="sidebar-item">
                    <a asp-controller="User" asp-action="Index" class="sidebar-link">
                        <i class='bx bxs-home'></i>
                        <span>Home</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="User" asp-action="Details" class="sidebar-link">
                        <i class='bx bxs-user-account'></i>
                        <span>Perfil</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link" onclick="document.getElementById('vehicleIndexForm').submit(); return false;">
                        <i class='bx bxs-car'></i>
                        <span>Mis Vehículos</span>
                    </a>
                    <form id="vehicleIndexForm" asp-controller="Vehicle" asp-action="Index" method="get" style="display: none;"></form>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link collapsed has-dropdown" data-bs-toggle="collapse"
                       data-bs-target="#tripsDropdown" aria-expanded="false" aria-controls="tripsDropdown">
                        <i class='bx bxs-landscape'></i>
                        <span>Viajes</span>
                    </a>
                    <ul id="tripsDropdown" class="sidebar-dropdown list-unstyled collapse" data-bs-parent="#sidebar">

                        <!-- Publicar Viaje -->
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link" onclick="document.getElementById('tripCreateForm').submit(); return false;">
                                Publicar Viaje
                            </a>
                            <form id="tripCreateForm" asp-controller="Trip" asp-action="Create" method="get" style="display: none;"></form>
                        </li>

                        <!-- Mis Viajes -->
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link" onclick="document.getElementById('tripMyTripsForm').submit(); return false;">
                                Mis Viajes
                            </a>
                            <form id="tripMyTripsForm" asp-controller="Trip" asp-action="Index" asp-route-myTrips=true method="get" style="display: none;">
                                <input type="hidden" name="myTrips" value="true" />
                            </form>
                        </li>

                        <!-- Unirme a un viaje -->
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link" onclick="document.getElementById('tripJoinForm').submit(); return false;">
                                Unirme a un viaje
                            </a>
                            <form id="tripJoinForm" asp-controller="Trip" asp-action="Index" method="get" style="display: none;">
                                <input type="hidden" name="status" value="@((int)GestorViajes.Models.EFCore.Rove.TripStatus.Available)" />
                            </form>
                        </li>
                    </ul>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="FuelTicket" asp-action="Index" class="sidebar-link">
                        <i class='bx bxs-notepad'></i>
                        <span>Mis Tickets</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link collapsed has-dropdown" data-bs-toggle="collapse"
                       data-bs-target="#multi" aria-expanded="false" aria-controls="multi">
                        <i class='bx bxs-credit-card'></i>
                        <span>Suscripción</span>
                    </a>
                    <ul id="multi" class="sidebar-dropdown list-unstyled collapse" data-bs-parent="#sidebar">
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link collapsed has-dropdown" data-bs-toggle="collapse"
                               data-bs-target="#multi-two" aria-expanded="false" aria-controls="multi-two">
                                Gestionar
                            </a>
                            <ul id="multi-two" class="sidebar-dropdown list-unstyled collapse">
                                <li class="sidebar-item">
                                    <a asp-controller="Home" asp-action="Plans" class="sidebar-link">Ver Planes</a>
                                </li>
                                <li class="sidebar-item">
                                    <a asp-controller="User" asp-action="Details" asp-route-id="@current.Id" class="sidebar-link">Cambiar suscripción</a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link" onclick="document.getElementById('aboutForm').submit(); return false;">
                        <i class='bx bxs-info-circle'></i>
                        <span>Sobre nosotros</span>
                    </a>
                    <form id="aboutForm" asp-controller="Home" asp-action="About" method="get" style="display: none;"></form>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="Home" asp-action="Comunity" class="sidebar-link">
                        <i class='bx bxl-instagram-alt'></i>
                        <span>Comunidad</span>
                    </a>
                </li>
            </ul>
            <div class="sidebar-footer">
                <a href="#" class="sidebar-link" onclick="document.getElementById('logoutForm').submit(); return false;">
                    <i class='bx bx-log-out'></i>
                    <span>Logout</span>
                </a>
                <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" style="display: none;">
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="main">
            <nav class="navbar navbar-expand px-4 py-3">
                <div class="navbar-collapse collapse">
                    <a href="#" class="text-body-secondary d-flex align-items-center text-tagline">
                        <em>“Encuentra lo extraordinario”</em>
                    </a>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a href="#" data-bs-toggle="dropdown" class="nav-icon pe-md-0">
                                <img src="~/img/logo3.png" asp-append-version="true" class="avatar img-fluid" alt="Usuario">
                            </a>
                            <div class="dropdown-menu dropdown-menu-end rounded-0 border-0 shadow mt-3">
                                <a asp-controller="User" asp-action="Details" class="dropdown-item">
                                    <i class='bx bx-smile'></i> <span>Perfil</span>
                                </a>
                                <a asp-controller="User" asp-action="Edit" asp-route-id="@current.Id" class="dropdown-item">
                                    <i class='bx bx-cog'></i> <span>Configuración</span>
                                </a>
                                <div class="dropdown-divider"></div>
                                <a href="#" class="dropdown-item" onclick="document.getElementById('helpForm').submit(); return false;">
                                    <i class='bx bx-help-circle'></i> <span>Ayuda</span>
                                </a>
                                <form id="helpForm" asp-controller="Home" asp-action="Help" method="get" style="display: none;"></form>
                            </div>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content Section -->
            <main class="content px-3 py-4">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </main>

            <footer class="footer">
                <!-- footer -->
            </footer>
        </div>
    </div>

    <!-- Scripts al final del body para evitar bloqueos de carga -->

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>

    <script src="~/js/script.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
