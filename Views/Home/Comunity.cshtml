@{
    ViewData["Title"] = "Comunidad";
}

<main class="container mt-5">
    <div class="text-center mb-5">
        <h1>&#64;Rove_urbex</h1>
        <h2>
            <img src="~/img/instagram.png" alt="Instagram" style="height: 40px; margin-right: 10px;" />
            Síguenos en nuestras redes sociales
        </h2>
        <p class="lead">Conoce a otros exploradores urbanos y compartid vuestros hallazgos!</p>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @for (int i = 1; i <= 8; i++) // hasta urbex8
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <img src="@Url.Content($"~/img/urbex{i}.jpg")" alt="Exploración urbana @i" class="card-img-top img-fluid" style="object-fit: cover; height: 250px;" />
                </div>
            </div>
        }
    </div>
</main>
