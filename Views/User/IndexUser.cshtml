@{
    ViewData["Title"] = "Dashboard";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Boxicons CSS -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Custom Stylesheet (style.css) -->
    <link href="~/css/style.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <aside id="sidebar">
            <div class="d-flex justify-content-between p-4" style="border-bottom: 1px dashed #606164;">
                <div class="sidebar-logo">
                    <a href="#">Rove</a>
                    <!-- <img src="img/logo2.png" alt="Logo" class="logo"> -->
                </div>
                <button class="toggle-btn border-0" type="button">
                    <i id="icon" class='bx bxs-chevrons-right'></i>
                </button>
            </div>
            <ul class="sidebar-nav">
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link">
                        <i class='bx bxs-user-account'></i>
                        <span>Perfil</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link">
                        <i class='bx bxs-photo-album'></i>
                        <span>Comunidad</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link collapsed has-dropdown" data-bs-toggle="collapse"
                       data-bs-target="#auth" aria-expanded="false" aria-controls="auth">
                        <i class='bx bxs-car'></i>
                        <span>Viajes</span>
                    </a>
                    <ul id="auth" class="sidebar-dropdown list-unstyled collapse" data-bs-parent="#sidebar">
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link">
                                Publicar Viaje
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link">
                                Mis Viajes
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link collapsed has-dropdown" data-bs-toggle="collapse"
                       data-bs-target="#multi" aria-expanded="false" aria-controls="multi">
                        <i class='bx bxs-credit-card'></i>
                        <span>Suscripción</span>
                    </a>
                    <ul id="multi" class="sidebar-dropdown list-unstyled collapse" data-bs-parent="#sidebar">
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link collapsed has-dropdown" data-bs-toggle="collapse"
                               data-bs-target="#multi-two" aria-expanded="false" aria-controls="multi-two">
                                Gestionar
                            </a>
                            <ul id="multi-two" class="sidebar-dropdown list-unstyled collapse">
                                <li class="sidebar-item">
                                    <a href="#" class="sidebar-link">Datos de pago</a>
                                </li>
                                <li class="sidebar-item">
                                    <a href="#" class="sidebar-link">Gestionar suscripción</a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link">
                        <i class='bx bxs-bell-ring'></i>
                        <span>Notificationes</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link">
                        <i class='bx bxs-info-circle'></i>
                        <span>Sobre nosotros</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="#" class="sidebar-link">
                        <i class='bx bxs-cog'></i>
                        <span>Configuración</span>
                    </a>
                </li>
            </ul>
            <div class="sidebar-footer">
                <a href="#" class="sidebar-link">
                    <i class='bx bx-log-out'></i>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="main">
            <nav class="navbar navbar-expand px-4 py-3">
                <div class="navbar-collapse collapse">
                    <a href="#" class="text-body-secondary d-flex align-items-center text-tagline">
                        <em>“Encuentra lo extraordinario”</em>
                    </a>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a href="#" data-bs-toggle="dropdown" class="nav-icon pe-md-0">
                                <img src="img/logo3.png" class="avatar img-fluid" alt="Usuario">
                            </a>
                            <div class="dropdown-menu dropdown-menu-end rounded-0 border-0 shadow mt-3">
                                <a href="#" class="dropdown-item"><i class='bx bx-data'></i> <span>Perfil</span></a>
                                <a href="#" class="dropdown-item">
                                    <i class='bx bx-cog'></i>
                                    <span>Configuración</span>
                                </a>
                                <div class="dropdown-divider"></div>
                                <a href="#" class="dropdown-item">
                                    <i class='bx bx-help-circle'></i>
                                    <span>Ayuda</span>
                                </a>
                            </div>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content Section -->
            <main class="content px-3 py-4">
                <div class="container-fluid">
                    <div class="mb-3">
                        <!-- Carousel de fotos-->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div id="carouselExampleIndicators" class="carousel slide shadow"
                                     data-bs-ride="carousel">
                                    <div class="carousel-indicators">
                                        <button type="button" data-bs-target="#carouselExampleIndicators"
                                                data-bs-slide-to="0" class="active" aria-current="true"
                                                aria-label="Slide 1"></button>
                                        <button type="button" data-bs-target="#carouselExampleIndicators"
                                                data-bs-slide-to="1" aria-label="Slide 2"></button>
                                        <button type="button" data-bs-target="#carouselExampleIndicators"
                                                data-bs-slide-to="2" aria-label="Slide 3"></button>
                                    </div>
                                    <div class="carousel-inner rounded">
                                        <div class="carousel-item active">
                                            <img src="img/urbex1.jpg" class="d-block w-100"
                                                 alt="Primera imagen">
                                        </div>
                                        <div class="carousel-item">
                                            <img src="img/urbex2.jpg" class="d-block w-100"
                                                 alt="Segunda imagen">
                                        </div>
                                        <div class="carousel-item">
                                            <img src="img/urbex3.jpg" class="d-block w-100"
                                                 alt="Tercera imagen">
                                        </div>
                                    </div>
                                    <button class="carousel-control-prev" type="button"
                                            data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Anterior</span>
                                    </button>
                                    <button class="carousel-control-next" type="button"
                                            data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Siguiente</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Publicar viaje -->
                        <div class="col-12 col-md-4">
                            <div class="card shadow">
                                <div class="card-body py-4">
                                    <h6 class="mb-2 fw-bold">Publicar viaje</h6>
                                    <p>
                                        Organiza y publica tu próximo destino. Comparte los detalles con otros
                                        viajeros.
                                    </p>
                                    <a href="#" class="btn btn-success btn-sm mt-2">Publicar</a>
                                </div>
                            </div>
                        </div>

                        <!-- Comunidad -->
                        <div class="col-12 col-md-4">
                            <div class="card shadow" style="background-color: #1b4724; color: #FFF;">
                                <div class="card-body py-4">
                                    <h6 class="mb-2 fw-bold">Comunidad</h6>
                                    <p>
                                        Conecta con otros aventureros, comparte experiencias y forma parte de
                                        nuestra red.
                                    </p>
                                    <a href="#" class="btn btn-light btn-sm mt-2">Ver Comunidad</a>
                                </div>
                            </div>
                        </div>

                        <!-- Mis publicaciones -->
                        <div class="col-12 col-md-4">
                            <div class="card shadow">
                                <div class="card-body py-4">
                                    <h6 class="mb-2 fw-bold">Mis publicaciones</h6>
                                    <p>
                                        Revisa y gestiona todos los viajes y experiencias que has compartido
                                        hasta ahora.
                                    </p>
                                    <a href="#" class="btn btn-success btn-sm mt-2">Mis Viajes</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <h3 class="fw-bold fs-4 mb-3">Mis Viajes</h3>
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Destino</th>
                                        <th scope="col">Fecha</th>
                                        <th scope="col">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <th scope="row">1</th>
                                        <td>París</td>
                                        <td>12/06/2025</td>
                                        <td>Publicado</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">2</th>
                                        <td>Tokyo</td>
                                        <td>22/08/2025</td>
                                        <td>En revisión</td>
                                    </tr>
                                    <tr>
                                        <th scope="row">3</th>
                                        <td>Roma</td>
                                        <td>15/09/2025</td>
                                        <td>Publicado</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Custom Scripts (script.js) -->
    <script src="~/js/script.js"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
