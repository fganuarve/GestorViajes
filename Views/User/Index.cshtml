@model List<GestorViajes.Models.ViewModels.Trip.TripViewModel>
@{
	ViewData["Title"] = "Dashboard";
	//Aplico Layout para poder ver el logo a la derecha arriba
	Layout = "_Layout";
}

<!-- Mostrar mensajes de error o éxito -->
@if (TempData["message"] != null)
{
	<div class="alert alert-@(TempData["status"])">
		@TempData["message"]
	</div>
}

<!-- Carrusel de imágenes -->
<div class="row mb-4">
	<div class="col-12">
		<div id="carouselExampleIndicators" class="carousel slide shadow" data-bs-ride="carousel">
			<div class="carousel-indicators">
				<button type="button" data-bs-target="#carouselExampleIndicators"
						data-bs-slide-to="0" class="active" aria-current="true"
						aria-label="Slide 1"></button>
				<button type="button" data-bs-target="#carouselExampleIndicators"
						data-bs-slide-to="1" aria-label="Slide 2"></button>
				<button type="button" data-bs-target="#carouselExampleIndicators"
						data-bs-slide-to="2" aria-label="Slide 3"></button>
			</div>
			<div class="carousel-inner rounded">
				<div class="carousel-item active">
					<img src="~/img/hurbex4.jpg" class="d-block w-100" alt="Primera imagen">
				</div>
				<div class="carousel-item">
					<img src="~/img/hurbex2.jpg" class="d-block w-100" alt="Segunda imagen">
				</div>
				<div class="carousel-item">
					<img src="~/img/hurbex3.jpg" class="d-block w-100" alt="Tercera imagen">
				</div>
			</div>
			<button class="carousel-control-prev" type="button"
					data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
				<span class="carousel-control-prev-icon" aria-hidden="true"></span>
				<span class="visually-hidden">Anterior</span>
			</button>
			<button class="carousel-control-next" type="button"
					data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
				<span class="carousel-control-next-icon" aria-hidden="true"></span>
				<span class="visually-hidden">Siguiente</span>
			</button>
		</div>
	</div>
</div>

<!-- Tarjetas -->
<div class="row g-4 mb-4">
	<!-- Aquí puedes colocar tarjetas como: Publicar Viaje, Comunidad, Mis publicaciones, etc. -->
</div>

<!-- Tabla de viajes -->
<div class="row mt-4">
	<div class="col-12">
		<h3 class="fw-bold fs-4 mb-3">Mis Viajes</h3>
		<table class="table table-striped">
			<thead>
				<tr>
					<th>#</th>
					<th>Origen</th>
					<th>Destino</th>
					<th>Fecha</th>
					<th>Estado</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var trip in Model)
				{
					<tr>
						<th>@trip.Id</th>
						<th>@trip.Origin</th>
						<td>@trip.Destination</td>
						<td>@trip.Date.ToString("dd/MM/yyyy")</td>
						<td>
							@if (trip.Status == (int)GestorViajes.Models.EFCore.Rove.TripStatus.Available)
							{
								<span class="badge bg-success">@trip.StatusDescription</span>
							}
							else if (trip.Status == (int)GestorViajes.Models.EFCore.Rove.TripStatus.Full)
							{
								<span class="badge bg-warning text-dark">@trip.StatusDescription</span>
							}
							else
							{
								<span class="badge bg-danger">@trip.StatusDescription</span>
							}
						</td>

					</tr>
				}
			</tbody>
		</table>
	</div>
</div>
